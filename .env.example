# Copy this file to .env and fill in your values.
# All three values are on your Foundry portal HOME page (the "Welcome, Sneha"
# screen): API key, Project endpoint, Azure OpenAI endpoint. Use the little
# copy buttons next to each field.

# Project endpoint (starts with https://festivalscout-foundry.servi...)
FOUNDRY_PROJECT_ENDPOINT=

# API key (the long hidden value)
FOUNDRY_API_KEY=

# Your agent's name in Foundry
FOUNDRY_AGENT_NAME=festivalscout-agent

# Azure OpenAI endpoint (starts with https://festivalscout-foundry.oper...)
AZURE_OPENAI_ENDPOINT=

# Your chat model deployment name
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Leave as is unless an API-version error tells you otherwise
AZURE_OPENAI_API_VERSION=2024-10-21
