# FestivalScout runs with NO configuration at all: leave this file empty (or don't
# create it) and the app uses the local TF-IDF retrieval backend and composes its
# analysis locally. Everything below is optional.

# --- Retrieval backend -------------------------------------------------------
# tfidf (default) = built-in, zero dependencies.
# dense           = sentence-transformers embeddings (pip install -r requirements-ml.txt)
RETRIEVAL_BACKEND=tfidf
# EMBEDDING_MODEL=all-MiniLM-L6-v2   # only used when RETRIEVAL_BACKEND=dense

# --- Reasoning provider ------------------------------------------------------
# none (default) = deterministic local synthesis from retrieved passages.
# openai         = any OpenAI-compatible chat endpoint.
# azure          = Azure OpenAI.
LLM_PROVIDER=none

# If LLM_PROVIDER=openai (works with OpenAI, OpenRouter, local Ollama, LM Studio):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# If LLM_PROVIDER=azure:
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
